Write a program to input a number and reverse it using return and case by argument:-
#include <iostream>
using namespace std;

// Function to reverse a number passed by argument
int reverseNumber(int num) {
    int reversed = 0;
    
    while (num != 0) {
        int remainder = num % 10;        
        reversed = reversed * 10 + remainder; 
        num /= 10;                        
    }
    return reversed;
}

int main() {
    int number;

    cout << "Enter a number: ";
    cin >> number;
    int result = reverseNumber(number);

    cout << "Reversed number: " << result << endl;

    return 0;
}