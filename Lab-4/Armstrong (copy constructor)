Write a program to input a number test if it is a Armstrong number or not using copy constructor:-

#include <iostream>
#include <cmath>
using namespace std;

class Armstrong {
private:
    int number;
public:
    Armstrong(int n = 0) : number(n) {}
    Armstrong(const Armstrong& other) : number(other.number) {}
    bool isArmstrong() {
        int original = number;
        int sum = 0;
        int digits = to_string(original).length();
        while (original > 0) {
            int digit = original % 10;
            sum += pow(digit, digits);
            original /= 10;
        }
        return sum == number;
    }
};

int main() {
    int num;
    cout << "Enter a number: ";
    cin >> num;
    Armstrong arm(num);
    if (arm.isArmstrong()) {
        cout << num << " is an Armstrong number." << endl;
    } else {
        cout << num << " is not an Armstrong number." << endl;
    }
    return 0;
}